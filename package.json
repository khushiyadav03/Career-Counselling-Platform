{
  "name": "career-counseling-bot",
  "version": "2.0.0",
  "description": "Full-stack career platform: learning paths, job search, CareerBot (Express + React + Vite)",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"node server.js\" \"vite\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server.js",
    "preview": "vite preview",
    "lint": "eslint src server.js lib --ext .js,.jsx",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
